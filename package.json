{
	"name": "buddi",
	"version": "1.5.0",
	"description": "BudDi is a web platform intended to automatically fill random budgets (either manually or regularly) and keep track of expenses.",
	"private": true,
	"keywords": [
		"Open Source",
		"Budget",
		"Randomizer",
		"Distribution",
		"Scheduler",
		"Donations"
	],
	"license": "MIT",
	"author": "JodliDev",
	"scripts": {
		"dev_backend": "npm run prepare_dist & node --watch -r ts-node/register src/backend/ts/index.ts -- sqlite=dist/config frontend=dist/frontend",
		"dev_frontend": "webpack --watch --stats-error-details --config webpack_config/build.dev.js",
		"build_production": "npm run prepare_dist & webpack --config webpack_config/build.production.js",
		"run_production": "node dist/backend/backend.js src/backend/ts/index.ts -- sqlite=dist/config frontend=dist/frontend",
		"prepare_dist": "node create_folder_structure.js"
	},
	"dependencies": {
		"bcrypt": "^6.0.0",
		"better-sqlite3": "^13.0.3",
		"express": "5.3.0",
		"mini-css-extract-plugin": "^2.9.0",
		"mithril": "^2.2.2",
		"ws": "^8.18.0"
	},
	"devDependencies": {
		"@types/bcrypt": "^6.0.0",
		"@types/better-sqlite3": "^9.6.0",
		"@types/express": "^5.0.6",
		"@types/mithril": "^2.2.6",
		"@types/node": "^26.6.5",
		"@types/ws": "^8.5.12",
		"copy-webpack-plugin": "^14.0.0",
		"css-loader": "^7.1.2",
		"favicons": "^7.2.0",
		"favicons-webpack-plugin": "^6.0.1",
		"html-loader": "^5.0.0",
		"html-webpack-plugin": "^5.6.0",
		"terser-webpack-plugin": "^5.3.10",
		"ts-loader": "^9.5.1",
		"ts-node": "^10.9.2",
		"typescript": "^5.3.2",
		"webpack": "5.112.2",
		"webpack-cli": "^7.2.3",
		"webpack-dev-server": "^6.1.0",
		"webpack-merge": "^6.0.1",
		"webpack-node-externals": "^3.0.0"
	},
	"allowScripts": {
		"sharp@0.33.5": true,
		"better-sqlite3@13.0.3": true,
		"bcrypt@6.0.0": true
	}
}
